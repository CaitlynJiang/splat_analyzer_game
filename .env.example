# Copy this file to .env and fill in your values.
# .env is never committed to git.

# SSH access to your GPU server
SERVER_IP=1.2.3.4
SERVER_USER=ubuntu
SSH_KEY=~/.ssh/my_key

# Admin panel credentials
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Your domain (must point to SERVER_IP before deploying)
DOMAIN=your-domain.com

# CUDA compute capability of the server GPU
# L40S=8.9  |  A100=8.0  |  RTX 3090/4090=8.6/8.9  |  H100=9.0
CUDA_ARCH_LIST=8.9

# ── game_server.py: the LLM behind VIN ───────────────────────────────────────
# Any OpenAI-compatible endpoint. Leave LLM_API_KEY empty and the game still
# runs, using local template descriptions.
#
#   Google Gemini     https://generativelanguage.googleapis.com/v1beta/openai/  gemini-flash-latest
#   Qwen / DashScope  https://dashscope.aliyuncs.com/compatible-mode/v1         qwen-plus
#   OpenAI            https://api.openai.com/v1                                 gpt-4o-mini
#   DeepSeek          https://api.deepseek.com/v1                               deepseek-chat
#   Ollama (local)    http://localhost:11434/v1                                 qwen2.5
#
# Use a *flash*-class model. VIN answers on every button press, so latency is
# felt directly; quality matters far less than speed here.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-latest
LLM_API_KEY=
LLM_TIMEOUT=12

# Gemini 3.x and other reasoning models spend tokens thinking before answering,
# which for a two-sentence description is pure latency and truncation risk.
# none | low | medium | high — leave as none unless VIN starts sounding dim.
LLM_REASONING_EFFORT=none
